# ═══════════════════════════════════════════════════════════
# SIMOGRANTS — Environment Variables
# Copy to .env and fill in the values
# ═══════════════════════════════════════════════════════════

# ── Cloudflare Authentication ──────────────────────────────
# Either use `npx wrangler login` OR set these:
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id

# API Token needs these permissions:
#   Account > Cloudflare Pages > Edit
#   Account > Workers Scripts > Edit
#   Account > Workers KV Storage > Edit
#   Account > D1 > Edit
#   Account > Workers R2 Storage > Edit
# Create at: https://dash.cloudflare.com/profile/api-tokens

# ── D1 Database (auto-created by scripts/setup-d1.sh) ────
D1_DATABASE_ID=auto_populated_by_setup_script

# ── KV & R2 (auto-created by scripts/setup-d1.sh) ────────
KV_NAMESPACE_ID=auto_populated_by_setup_script
R2_BUCKET_NAME=simogrants-evidence

# ── Blockchain / Contracts ────────────────────────────────
# For contract deployment (Hardhat)
DEPLOYER_PRIVATE_KEY=0x_your_deployer_private_key
BASE_SEPOLIA_RPC=https://sepolia.base.org
BASE_MAINNET_RPC=https://mainnet.base.org

# Deployed contract addresses (populated after deployment)
# ATTESTATION_CONTRACT_ADDRESS=0x...

# ── BaseScan API Key (optional, for contract verification) ─
BASESCAN_API_KEY=your_basescan_api_key

# ── Backend (Cloudflare Workers) ──────────────────────────
# Set these as secrets via Cloudflare dashboard or wrangler secret:
#   npx wrangler secret put SIWE_SECRET --env production
SIWE_SECRET=your_siwe_session_secret_32_bytes_hex

# ── App URLs ──────────────────────────────────────────────
# Local development
APP_URL=http://localhost:5173
API_URL=http://localhost:8787

# Production (populated after deployment)
# APP_URL=https://simogrants.pages.dev
# API_URL=https://simogrants-api.your-subdomain.workers.dev
