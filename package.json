{
  "name": "simogrants",
  "version": "2.0.0",
  "private": true,
  "description": "SIMOGRANTS — Stigmergic Impact Oracle for Grants (Cloudflare Web4)",
  "workspaces": [
    "packages/backend",
    "packages/frontend",
    "packages/contracts"
  ],
  "scripts": {
    "dev": "npm run dev:backend & npm run dev:frontend",
    "dev:backend": "npm run dev -w packages/backend",
    "dev:frontend": "npm run dev -w packages/frontend",
    "build": "npm run build:frontend",
    "build:frontend": "npm run build -w packages/frontend",
    "compile:contracts": "npm run compile -w packages/contracts",
    "test": "npm run test:contracts",
    "test:contracts": "npm run test -w packages/contracts",
    "setup:infra": "bash scripts/setup-d1.sh",
    "deploy": "bash scripts/deploy-all.sh",
    "deploy:backend": "npm run deploy -w packages/backend",
    "deploy:frontend": "npm run deploy -w packages/frontend",
    "db:init": "npm run db:init -w packages/backend",
    "db:seed": "npm run db:seed -w packages/backend",
    "db:reset": "npm run db:reset -w packages/backend"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "playwright": "^1.58.2"
  }
}
